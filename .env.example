# Variables d'environnement de Sainte Populaire.
# En local : copier ce fichier en .env et remplir les valeurs.
# En production : les saisir dans Vercel > Project > Settings > Environment Variables.

# Identifiant admin (optionnel, "admin" par défaut)
ADMIN_USERNAME=admin

# Mot de passe admin (obligatoire, long et unique)
ADMIN_PASSWORD=

# Secret de signature des sessions et de chiffrement des demandes d'ajout (obligatoire).
# Ne plus le changer une fois en production : les demandes en attente deviendraient illisibles.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Jeton Vercel Blob (créé automatiquement quand on relie un store Blob au projet Vercel)
BLOB_READ_WRITE_TOKEN=
